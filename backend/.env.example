# ---------------------------------------------------------------
# Cricket League — environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored and
# MUST NEVER be committed. See SECRETS-ROTATION.md if a secret leaks.
# ---------------------------------------------------------------

# --- Server ---
PORT=3000
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API and
# open sockets. Leave empty in development to allow localhost only.
# Production example: https://play.example.com,https://www.example.com
CORS_ORIGINS=

# --- Database (XAMPP MariaDB) ---
# XAMPP's MariaDB is commonly on 3307 when 3306 is already taken.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=cricket_league
DB_USER=root
DB_PASSWORD=

# --- Redis (optional) ---
# Only needed to run more than one server process. Leave empty for a
# single-process deployment; the app uses an in-memory adapter instead.
REDIS_URL=

# --- Auth ---
# REQUIRED. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to boot in production if this is missing or weak.
JWT_SECRET=
JWT_EXPIRY=30d

# --- Google Sign-In (Google Cloud Console → Credentials) ---
# CLIENT_ID is public and is served to the browser.
# CLIENT_SECRET is NOT used by this server (ID tokens are verified against
# Google's public keys) — leave it blank unless you add a server-side OAuth
# code exchange flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook Login (Meta for Developers → App Settings) ---
# APP_ID is public. APP_SECRET is required server-side to verify access
# tokens via the debug_token endpoint. Keep it secret.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
